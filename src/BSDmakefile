PROG	 = sdl2trs

SRCS	+= debug.c
SRCS	+= dis.c
SRCS	+= error.c
SRCS	+= main.c
SRCS	+= trs_cassette.c
SRCS	+= trs_clones.c
SRCS	+= trs_cmd_rom.c
SRCS	+= trs_cp500.c
SRCS	+= trs_disk.c
SRCS	+= trs_hard.c
SRCS	+= trs_imp_exp.c
SRCS	+= trs_interrupt.c
SRCS	+= trs_io.c
SRCS	+= trs_memory.c
SRCS	+= trs_mkdisk.c
SRCS	+= trs_options.c
SRCS	+= trs_printer.c
SRCS	+= trs_sdl_gui.c
SRCS	+= trs_sdl_interface.c
SRCS	+= trs_sdl_keyboard.c
SRCS	+= trs_sdl_keymap.c
SRCS	+= trs_state_save.c
SRCS	+= trs_stringy.c
SRCS	+= trs_uart.c
SRCS	+= z80.c
SRCS	+= PasteManager.c

CPPSRCS += rg35xx/RG35XXControls.cpp
CPPSRCS += rg35xx/KeyboardRG35XXControls.cpp
CPPSRCS += rg35xx/RG35XXInputRouter.cpp
CPPSRCS += rg35xx/SoftKeyboard.cpp
CPPSRCS += rg35xx/SoftKeyboardRenderer.cpp
CPPSRCS += rg35xx/TrsKeyboardAdapter.cpp
CPPSRCS += rg35xx/rg35xx_bridge.cpp

OBJS	 = ${SRCS:.c=.o} ${CPPSRCS:.cpp=.o}

ENDIAN	!= echo; echo "ab" | od -x | grep "6261" > /dev/null || echo "-Dbig_endian"
LIBS	+= -lcurses -lreadline
SDL_INC	!= sdl2-config --cflags
SDL_LIB	!= sdl2-config --libs
MACROS	+= -DREADLINE -DZBX -DROM_PATH='"${ROM_PATH}"'
CFLAGS	?= -g -Wall
CFLAGS	+= ${SDL_INC} ${ENDIAN} ${MACROS}
CXXFLAGS ?= -g -Wall
CXXFLAGS += -std=c++11 ${SDL_INC}

${PROG}: ${OBJS}
	${CXX} -o ${PROG} ${OBJS} ${LIBS} ${SDL_LIB} ${LDFLAGS}

.PHONY: clean
clean:
	rm -f ${OBJS} ${PROG}
